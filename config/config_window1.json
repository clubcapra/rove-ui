        {"label": "ARM CAM",   "event": "camera.select", "value": "ARM_CAM",   "active_topic": "camera.select"},
        {"label": "LEFT CAM",  "event": "camera.select", "value": "LEFT_CAM",  "active_topic": "camera.select"},
