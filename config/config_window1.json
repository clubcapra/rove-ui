{
  "header_settings": {
    "signals": [
      {"name": "MicroHard", "host": "192.168.2.10"}
    ],
    "ping_interval_s": 2,
    "batteries": [
      {"name": "ROVE",   "topic": "battery.percentage", "unit": "V"},
      {"name": "STATION",     "topic": "system.battery",     "unit": "%", "source": "system", "poll_interval_s": 30}
    ],
    "E-Stop": {
      "active_color":   "#ff3d3d",
      "inactive_color": "#00e676",
      "topic": "estop_status"
    }
  },

  "udp_clients": [
    {
      "type": "udp_poll", "name": "odrive_32",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "odrive_32",
      "discovery_port_field": "data_port",
      "topic": "odrive.32", "topic_prefix": "odrive.32",
      "proto_type": "DriveNodeState", "publish_field_topics": true,
      "poll_interval_ms": 100, "recv_timeout_s": 2.0,
      "rediscovery_interval_s": 30, "enabled": true
    },
    {
      "type": "udp_poll", "name": "odrive_33",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "odrive_33",
      "discovery_port_field": "data_port",
      "topic": "odrive.33", "topic_prefix": "odrive.33",
      "proto_type": "DriveNodeState", "publish_field_topics": true,
      "poll_interval_ms": 100, "recv_timeout_s": 2.0,
      "rediscovery_interval_s": 30, "enabled": true
    },
    {
      "type": "udp_poll", "name": "odrive_34",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "odrive_34",
      "discovery_port_field": "data_port",
      "topic": "odrive.34", "topic_prefix": "odrive.34",
      "proto_type": "DriveNodeState", "publish_field_topics": true,
      "poll_interval_ms": 100, "recv_timeout_s": 2.0,
      "rediscovery_interval_s": 30, "enabled": true
    },
    {
      "type": "udp_poll", "name": "odrive_31",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "odrive_31",
      "discovery_port_field": "data_port",
      "topic": "odrive.31", "topic_prefix": "odrive.31",
      "proto_type": "DriveNodeState", "publish_field_topics": true,
      "poll_interval_ms": 100, "recv_timeout_s": 2.0,
      "rediscovery_interval_s": 30, "enabled": true
    },
    {
      "type": "udp_poll", "name": "vn300",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "vectornav_ttyUSB_VN300",
      "discovery_port_field": "data_port",
      "topic": "gnss", "topic_prefix": "gnss",
      "proto_type": "Vn300", "publish_field_topics": true,
      "poll_interval_ms": 100, "recv_timeout_s": 2.0,
      "rediscovery_interval_s": 30, "enabled": true
    },
    {
      "type": "udp_poll", "name": "kinova_arm",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "kinova_arm",
      "discovery_port_field": "data_port",
      "topic": "kinova_arm", "topic_prefix": "kinova_arm",
      "publish_field_topics": true,
      "poll_interval_ms": 100, "recv_timeout_s": 2.0,
      "rediscovery_interval_s": 30, "enabled": true
    }
  ],

  "ros2_clients": [],
  "console": true,

  "views": {

    "MISSION": {
      "type": "layout",
      "diaposition": "absolute",
      "content": [
        {
          "type": "map",
          "name": "Carte GPS",
          "style": { "x": 0, "y": 0, "width": "100%", "height": "100%", "z_index": 0 },
          "data": {
            "initial_lat": 46.759,
            "initial_lng": 7.616,
            "initial_zoom": 15,
            "tile_source_topic": "map.tile_source",
            "robot_position_lat_topic": "gnss.latitude",
            "robot_position_lng_topic": "gnss.longitude",
            "robot_position_yaw_topic": "gnss.yaw",
            "click_topic":    "map.click",
            "poi_topic":      "map.poi",
            "add_poi_at_topic": "costmap.poi"
          }
        },
        {
          "type": "button_bar",
          "name": "cam_selector",
          "style": {
            "x": "center", "bottom": 14,
            "width": "auto", "height": 40,
            "z_index": 1
          },
          "data": {
            "height": 40,
            "buttons": [
              {
                "label": "REAR CAM",
                "event": "camera.select",
                "value": "REAR_CAM",
                "active_topic": "camera.select"
              },
              {
                "label": "ARM CAM",
                "event": "camera.select",
                "value": "ARM_CAM",
                "active_topic": "camera.select"
              }
            ]
          }
        },
        {
          "type": "button_bar",
          "name": "action_bar",
          "style": {
            "x": "center", "bottom": 62,
            "width": "auto", "height": 40,
            "z_index": 1
          },
          "data": {
            "height": 40,
            "buttons": [
              {
                "label": "E-STOP",
                "event": "estop_status",
                "value": "1",
                "off_value": "0",
                "toggle": true,
                "color": "#ff3d3d"
              },
              {
                "label": "START MAPPING",
                "event": "mapping.start",
                "value": "1",
                "color": "#00e676"
              },
              {
                "label": "MAPPING BUILD",
                "event": "mapping.build",
                "value": "1",
                "color": "#ffae00"
              }

            ]
          }
        }
      ]
    },

    "TELEMETRY": {
      "type": "layout",
      "diaposition": "grid",
      "grid": { "rows": 2, "columns": 2, "spacing": 6 },
      "content": [
        {
          "type": "chart",
          "name": "Position Moteurs",
          "label": "POSITION MOTEURS",
          "data": {
            "chart_type": "lines",
            "title": "Position Moteurs",
            "series_name": "Position",
            "label_key": "Parameter",
            "value_key": "Value",
            "data": [
              {"Parameter": "FL", "Value": 0, "unit": "turns", "topic": "odrive.32.pos_estimate"},
              {"Parameter": "RL", "Value": 0, "unit": "turns", "topic": "odrive.33.pos_estimate"},
              {"Parameter": "FR", "Value": 0, "unit": "turns", "topic": "odrive.34.pos_estimate"},
              {"Parameter": "RR", "Value": 0, "unit": "turns", "topic": "odrive.31.pos_estimate"}
            ]
          },
          "grid": { "row": 0, "column": 0 }
        },
        {
          "type": "chart",
          "name": "Temp. Moteurs",
          "label": "TEMP. MOTEURS",
          "data": {
            "chart_type": "band",
            "title": "Températures Moteurs",
            "series_name": "Temperature",
            "label_key": "Parameter",
            "value_key": "Value",
            "data": [
              {"Parameter": "FL", "Value": 0, "unit": "°C", "topic": "odrive.32.motor_temp"},
              {"Parameter": "RL", "Value": 0, "unit": "°C", "topic": "odrive.33.motor_temp"},
              {"Parameter": "FR", "Value": 0, "unit": "°C", "topic": "odrive.34.motor_temp"},
              {"Parameter": "RR", "Value": 0, "unit": "°C", "topic": "odrive.31.motor_temp"}
            ]
          },
          "grid": { "row": 0, "column": 1 }
        },
        {
          "type": "chart",
          "name": "Temp. Drivers",
          "label": "TEMP. DRIVERS",
          "data": {
            "chart_type": "band",
            "title": "Températures Drivers",
            "series_name": "Temperature",
            "label_key": "Parameter",
            "value_key": "Value",
            "data": [
              {"Parameter": "FL", "Value": 0, "unit": "°C", "topic": "odrive.32.fet_temp"},
              {"Parameter": "RL", "Value": 0, "unit": "°C", "topic": "odrive.33.fet_temp"},
              {"Parameter": "FR", "Value": 0, "unit": "°C", "topic": "odrive.34.fet_temp"},
              {"Parameter": "RR", "Value": 0, "unit": "°C", "topic": "odrive.31.fet_temp"}
            ]
          },
          "grid": { "row": 1, "column": 0 }
        },
        {
          "type": "robot",
          "name": "Rove3D",
          "label": "3D VIEWER",
          "data": {
            "urdf": "src/media/rove_urdf/rove.urdf",
            "link_colors": {
              "Core": "#c8c8d0", "FlipperFL": "#72c572", "FlipperBL": "#6b6bc4",
              "FlipperFR": "#d56868", "FlipperBR": "#e1e17c",
              "DrumFL": "#5aab5a", "DrumBL": "#5a5aaa", "DrumFR": "#bb5555", "DrumBR": "#c4c45a",
              "Base": "#b0b8c8", "ASection": "#8fa0b8", "BSection": "#7890a8",
              "JointA": "#a0b0c0", "JointB": "#a0b0c0", "JointGripper": "#c8a070",
              "dji_mid360": "#303040", "vn300_vectornav": "#404050",
              "chinese_camera": "#202028", "chinese_camera_2": "#202028", "chinese_camera_3": "#202028"
            },
            "controls": {
              "joint_angles": [
                {"joint": "joint_revolute_9",  "topic": "kinova_arm.joint_1_pos", "scale": 0.01745, "offset": 1.5708},
                {"joint": "joint_revolute_10", "topic": "kinova_arm.joint_2_pos", "scale": -0.01745, "offset": 0},
                {"joint": "joint_revolute_11", "topic": "kinova_arm.joint_3_pos", "scale": 0.01745, "offset": 1.5708},
                {"joint": "joint_revolute_12", "topic": "kinova_arm.joint_4_pos", "scale": 0.01745, "offset": 0},
                {"joint": "joint_revolute_13", "topic": "kinova_arm.joint_5_pos", "scale": 0.01745, "offset": 1.5708},
                {"joint": "joint_revolute_14", "topic": "kinova_arm.joint_6_pos", "scale": 0.01745, "offset": 1.5708}
              ],
              "robot_pose": {
                "roll_topic":  "gnss.roll",
                "pitch_topic": "gnss.pitch",
                "yaw_topic":   "gnss.yaw"
              }
            }
          },
          "grid": { "row": 1, "column": 1 }
        }
      ]
    },

    "COSTMAP": {
      "type": "layout",
      "diaposition": "grid",
      "grid": { "rows": 1, "columns": 1, "spacing": 0 },
      "content": [
        {
          "type": "bitmap",
          "name": "Costmap",
          "label": "COSTMAP",
          "data": {
            "source": "http://localhost:8080/map_feed",
            "cornerPositionWidth": 8,
            "cornerPositionHeight": 8,
            "click_topic": "costmap.click",
            "poi_topic": "costmap.poi",
            "add_poi_gps_topic": "map.poi",
            "gps_lat_topic": "gnss.latitude",
            "gps_lng_topic": "gnss.longitude",
            "gps_yaw_topic": "gnss.yaw"
          },
          "grid": { "row": 0, "column": 0 }
        }
      ]
    },

    "MISSION BUILDER": {
      "type": "layout",
      "diaposition": "vertical",
      "content": [
        {
          "type": "mission_builder",
          "name": "mission_builder",
          "data": {
            "manifest_path": "src/media/mission_manifest.json",
            "send_topic": "mission.send"
          }
        }
      ]
    },

    "TILES": {
      "type": "layout",
      "diaposition": "vertical",
      "content": [{
        "type": "tile_downloader",
        "name": "tile_downloader",
        "data": {
          "server_port": 8181,
          "tiles_dir": "tiles",
          "tile_source_topic": "map.tile_source"
        }
      }]
    },

    "LOGS": {
      "type": "layout",
      "diaposition": "vertical",
      "content": [
        { "type": "console", "name": "event_log" }
      ]
    }

  }
}
