{
  "header_settings": {
    "signals": [
      {"name": "MicroHard", "host": "192.168.2.10"}
    ],
    "ping_interval_s": 2,
    "batteries": [
      {"name": "ROVE",   "topic": "battery.percentage", "unit": "V"},
      {"name": "STATION",     "topic": "system.battery",     "unit": "%", "source": "system", "poll_interval_s": 30}
    ],
    "E-Stop": {
      "active_color":   "#ff3d3d",
      "inactive_color": "#00e676",
      "topic": "estop_status"
    } 
  },

  "udp_clients": [
    {
      "type": "udp_poll", "name": "vn300",
      "base_url": "http://192.168.2.2:8080",
      "discovery_endpoint": "/discover",
      "discovery_sensor_id": "vectornav_ttyUSB_VN300",
      "discovery_port_field": "data_port",
      "topic": "gnss", "topic_prefix": "gnss",
      "proto_type": "Vn300", "publish_field_topics": true,
      "recv_timeout_s": 2.0, "rediscovery_interval_s": 30, "enabled": true
    }
  ],

  "console": true,

  "views": {
    "CAMERA": {
      "type": "layout",
      "diaposition": "absolute",
      "content": [
        {
          "type": "camera",
          "name": "Camera",
          "style": { "x": 0, "y": 0, "width": "100%", "height": "100%", "z_index": 0 },
          "data": {
            "mode": "rtsp",
            "hide_controls": true,
            "select_topic": "camera.select",
            "vtx_host": "192.168.2.2",
            "vtx_port": 5540,
            "cameras": [
              {"name": "ARM_CAM", "udp_vtx_id": 0, "rtsp_ip": "192.168.2.36"},
              {"name": "REAR_CAM",  "udp_vtx_id": 1, "rtsp_ip": "192.168.2.31"},
              {"name": "LEFT_CAM", "udp_vtx_id": 2, "rtsp_ip": "192.168.2.32"},
              {"name": "RIGHT_CAM", "udp_vtx_id": 3, "rtsp_ip": "192.168.2.33"},
              {"name": "BACK_CAM", "udp_vtx_id": 4, "rtsp_ip": "192.168.2.34"},
              {"name": "FRONT_CAM", "udp_vtx_id": 5, "rtsp_ip": "192.168.2.35"}

            ],
            "rtsp":      { "source": "rtsp://192.168.2.30:554/", "source_type": "rtsp" },
            "webcamera": {
              "device_path": "/dev/video0",
              "responsive":  { "aspect_ratio": "4:3", "overflow_anchor": "center" }
            }
          }
        },
        {
          "type": "bitmap",
          "name": "costmap_overlay",
          "style": {
            "right": 14, "bottom": 14,
            "width": 220, "height": 220,
            "z_index": 2
          },
          "data": {
            "data_topic": "costmap.grid",
            "round": true,
            "cornerPositionWidth": 8,
            "cornerPositionHeight": 8,
            "gps_lat_topic": "gnss.latitude",
            "gps_lng_topic": "gnss.longitude",
            "gps_yaw_topic": "gnss.yaw"
          }
        },
        {
          "type": "robot",
          "name": "RobotOverlay",
          "label": "ROBOT STATUS",
          "style": {
            "x": 14, "bottom": 14,
            "width": 320, "height": 260,
            "z_index": 1
          },
          "data": {
            "urdf": "src/media/rove_urdf/rove.urdf",
            "hide_joint_panel": true,
            "link_colors": {
              "Core":              "#1e1e1e",
              "FlipperFL":         "#2a2a2a",
              "FlipperBL":         "#2a2a2a",
              "FlipperFR":         "#2a2a2a",
              "FlipperBR":         "#2a2a2a",
              "Base":              "#1a1a1a",
              "ASection":          "#1e1e1e",
              "BSection":          "#1e1e1e",
              "JointA":            "#222222",
              "JointB":            "#222222",
              "JointGripper":      "#2a2020",
              "dji_mid360":        "#141414",
              "vn300_vectornav":   "#141414",
              "chinese_camera":    "#101010",
              "chinese_camera_2":  "#101010",
              "chinese_camera_3":  "#101010"
            },
            "controls": {
              "thermal_links": [
                {
                  "link": "DrumFL", "topic": "odrive.32.motor_temp",
                  "min_temp": 20, "max_temp": 80
                },
                {
                  "link": "DrumBL", "topic": "odrive.33.motor_temp",
                  "min_temp": 20, "max_temp": 80
                },
                {
                  "link": "DrumFR", "topic": "odrive.34.motor_temp",
                  "min_temp": 20, "max_temp": 80
                },
                {
                  "link": "DrumBR", "topic": "odrive.31.motor_temp",
                  "min_temp": 20, "max_temp": 80
                }
              ],
              "joint_angles": [
                {"joint": "joint_revolute_9",  "topic": "kinova_arm.joint_1_pos", "scale": 0.01745, "offset": 1.5708},
                {"joint": "joint_revolute_10", "topic": "kinova_arm.joint_2_pos", "scale": -0.01745, "offset": 0},
                {"joint": "joint_revolute_11", "topic": "kinova_arm.joint_3_pos", "scale": 0.01745, "offset": 1.5708},
                {"joint": "joint_revolute_12", "topic": "kinova_arm.joint_4_pos", "scale": 0.01745, "offset": 0},
                {"joint": "joint_revolute_13", "topic": "kinova_arm.joint_5_pos", "scale": 0.01745, "offset": 1.5708},
                {"joint": "joint_revolute_14", "topic": "kinova_arm.joint_6_pos", "scale": 0.01745, "offset": 1.5708}
              ],
              "robot_pose": {
                "roll_topic":  "gnss.roll",
                "pitch_topic": "gnss.pitch",
                "yaw_topic":   "gnss.yaw"
              }
            }
          }
        }
      ]
    },
    "INPUT MANAGER": {
      "type": "layout",
      "diaposition": "vertical",
      "content": [
        {
          "type": "input_manager",
          "name": "gamepad",
          "data": {
            "default_config": "config/input_config.yml",
            "udp_host": "192.168.2.2",
            "udp_port": 9000
          }
        }
      ]
    }

  },

  "controls": {}
}