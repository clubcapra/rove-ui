{
  "schema_version": 1,
  "firmware_hash": "REPLACE_AT_BUILD_e3b0c44298fc1c14",
  "loadout": "standard",

  "_doc": "Exported by the robot's behavior-tree node registry at connect-time. The UI builds its command palette and parameter forms from this file and validates a composed mission against it BEFORE serializing to protobuf. 'available'/'requires' gate commands by current loadout (e.g. arm vs cage). firmware_hash must match the value embedded in the mission the UI sends back; mismatch => UI warns/refuses.",

  "variable_types": ["entity", "point", "geometry"],

  "ref_sources": {
    "map_coordinate": "operator taps the map / enters a coordinate",
    "variable:entity": "a tracked vision object bound at runtime (e.g. $human)",
    "variable:point":  "a coordinate captured at runtime (e.g. $point_a)",
    "vision_object":   "a live object id from the vision stream (e.g. PERSON-01)"
  },

  "transitions": {
    "until_done_next": { "label": "until done → next", "needs_count": false, "desc": "run to success, advance to next step" },
    "until_done_end":  { "label": "until done → end",  "needs_count": false, "desc": "run to success, end the mission" },
    "until_stopped":   { "label": "until stopped",      "needs_count": false, "desc": "run until operator preempts" },
    "loop_n":          { "label": "loop N×",            "needs_count": true,  "desc": "repeat count times, then advance" }
  },

  "vision_classes": ["person", "vehicle", "drone", "robot", "poi"],

  "commands": [
    {
      "id": "Await", "category": "flow", "ui": { "icon": "hourglass_top" },
      "desc": "Wait until a condition is met, then bind the detected entity.",
      "params": [
        { "name": "condition", "type": "enum", "required": true,
          "values": ["human_detected", "human_pose_a", "human_pose_b", "object_vehicle", "comms_regained", "audio_ping"] }
      ],
      "produces": { "type": "entity" },
      "valid_transitions": ["until_done_next"],
      "available": true
    },

    {
      "id": "GoTo", "category": "navigation", "ui": { "icon": "near_me" },
      "desc": "Drive to a coordinate.",
      "params": [
        { "name": "a", "type": "ref", "required": true, "accepts": ["map_coordinate", "variable:point"] }
      ],
      "valid_transitions": ["until_done_next", "until_done_end"],
      "available": true
    },
    {
      "id": "Pathway", "category": "navigation", "ui": { "icon": "polyline" },
      "desc": "Navigate through an ordered sequence of coordinates.",
      "params": [
        { "name": "points", "type": "point_list", "required": true, "min_points": 2,
          "accepts": ["map_coordinate", "variable:point"] }
      ],
      "valid_transitions": ["until_done_next", "until_done_end"],
      "available": true
    },
    {
      "id": "Sentinel", "category": "navigation", "ui": { "icon": "sync_alt" },
